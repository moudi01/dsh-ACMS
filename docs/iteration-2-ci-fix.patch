diff --git a/docs/external-agent-onboarding.md b/docs/external-agent-onboarding.md
index 99c2007..252703b 100644
--- a/docs/external-agent-onboarding.md
+++ b/docs/external-agent-onboarding.md
@@ -40,7 +40,18 @@ icacls $tokenFile /inheritance:r /grant:r "*${me}:(R,W)" | Out-Null
 if ($LASTEXITCODE -ne 0) { throw "icacls 失败：退出码 $LASTEXITCODE" }
 $acl = Get-Acl -LiteralPath $tokenFile
 if (-not $acl.AreAccessRulesProtected) { throw "token 文件仍继承父目录权限" }
-$other = @($acl.Access | Where-Object { $_.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value -ne $me })
+# Some hosts (including GitHub Windows runners) create the file with explicit
+# default-DACL ACEs for other identities. /inheritance:r only removes inherited
+# ACEs, so rebuild the DACL and keep only the current user before verifying.
+$acl.SetAccessRuleProtection($true, $false)
+foreach ($rule in @($acl.Access)) {
+  if ($rule.IsInherited) { continue }
+  $sid = $rule.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value
+  if ($sid -ne $me) { [void]$acl.RemoveAccessRuleSpecific($rule) }
+}
+Set-Acl -LiteralPath $tokenFile -AclObject $acl -ErrorAction Stop
+$acl = Get-Acl -LiteralPath $tokenFile
+if (@($acl.Access).Count -ne 1) { throw "token file must have exactly one ACE" }$other = @($acl.Access | Where-Object { $_.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value -ne $me })
 if ($other.Count -gt 0) { throw "token 文件仍允许其他身份访问" }
 Remove-Variable -Name token,secure,ptr -ErrorAction SilentlyContinue
 "token 已写入 $tokenFile；ACL：仅当前用户可读写"
diff --git a/test/external-onboarding-doc.test.js b/test/external-onboarding-doc.test.js
index 027c4cf..06d839a 100644
--- a/test/external-onboarding-doc.test.js
+++ b/test/external-onboarding-doc.test.js
@@ -79,3 +79,30 @@ test("the onboarding guide, API contract, and issue form describe the same goal
   assert.equal(access.includes("指定后仅限该目标"), false);
   assert.match(api, /目标由该凭据提交/);
 });
+
+import { mkdir, writeFile } from "node:fs/promises";
+
+test("the published token setup removes explicit foreign ACEs on an existing token file", async () => {
+  const home = await mkdtemp(path.join(os.tmpdir(), "acms-onboarding-foreign-"));
+  const tokenFile = path.join(home, ".dsh", "acms", "agent-token");
+  try {
+    await mkdir(path.dirname(tokenFile), { recursive: true });
+    await writeFile(tokenFile, "stale", "utf8");
+    const grant = spawnSync("icacls", [tokenFile, "/grant", "*S-1-1-0:(R)"], { encoding: "utf8", windowsHide: true });
+    assert.equal(grant.status, 0, grant.stderr || grant.stdout);
+    const before = readTokenAcl(tokenFile);
+    const beforeRules = [].concat(before.rules || []);
+    assert.ok(beforeRules.some((rule) => rule.sid !== before.currentUser), "fixture must contain an explicit foreign ACE");
+    const token = "acms_ag_" + "x".repeat(48);
+    const run = runTokenSetup({ home, token });
+    assert.equal(run.status, 0, run.stderr || run.stdout);
+    const after = readTokenAcl(tokenFile);
+    const afterRules = [].concat(after.rules || []);
+    assert.equal(after.protected, true);
+    assert.equal(afterRules.length, 1);
+    assert.equal(afterRules[0].sid, after.currentUser);
+    assert.equal(afterRules[0].inherited, false);
+  } finally {
+    await removeFixture(home);
+  }
+});
